# Database (PostgreSQL - Free on Oracle Cloud)
DATABASE_URL="postgresql://user:password@localhost:5432/offgrid1?schema=public"

# NextAuth.js (Free, self-hosted)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# Google OAuth (Free to use, costs only when users sign up)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Stripe (Free to integrate, 2.9% + €0.25 per transaction when you have paying customers)
# Leave empty until you're ready to accept payments
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Email (Resend free tier: 100 emails/day, 3,000/month)
RESEND_API_KEY=""

# Optional: Analytics (Free tiers available)
NEXT_PUBLIC_GA_ID=""
